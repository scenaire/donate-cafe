# Stripe — from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx

# Stripe publishable key — safe to expose to the browser; used by the card
# Payment Element. From the same dashboard.stripe.com/apikeys page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Optional test-mode keys. When NODE_ENV is not "production" (i.e. `next dev`
# and the test suite), the app prefers these over the live keys above, so local
# work can never move real money. Leave unset to use the live keys everywhere.
# Both switch together on NODE_ENV, so they are always the same mode. Toggle
# test mode in the Stripe Dashboard to read the sk_test_/pk_test_ pair.
STRIPE_SECRET_KEY_TEST=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxx

# Stripe — from the webhook endpoint you create at dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Alert widget — only used once, to seed cafe_settings.widget_token on first
# deploy (see the alert_overlay_config migration). After that the live token
# lives in the database and is rotatable from Settings → Alerts; this env var
# is no longer read at runtime. Any long random string you make up yourself.
ALERT_WIDGET_TOKEN=xxx

# ── Supabase ───────────────────────────────────────────────────────────────
# From your project's Settings → API page.

# Project URL. Needed on both server and browser, hence the NEXT_PUBLIC copy.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon key — public by design, ships to the browser. Safe: supabase/schema.sql
# enables RLS with no policies, so this key grants no table access at all. It is
# used only for the auth session and the alert widget's Realtime subscription.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Service-role key — SECRET. Bypasses RLS entirely. Server-side only; if this
# ever reaches the browser, every tip you have ever received is readable.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# The single admin email allowed to sign in to /dashboard via magic link.
ADMIN_EMAIL=you@example.com

# Protects the daily Vercel Cron call to /api/sweep. Any long random string.
CRON_SECRET=xxx

# NOTE: DASHBOARD_TOKEN is retired — /dashboard now uses a Supabase Auth
# session instead of a token in the URL.

# Tip-goal bridge (wishlist repo PLAN §6). WISHLIST_SITE_URL is the wishlist
# site's origin (no trailing path); BRIDGE_SHARED_SECRET is one secret shared
# with it — the SAME string must be BRIDGE_SHARED_SECRET on the wishlist side.
# Only used while a goal with kind='wishlist' is active; unset = bridge off.
WISHLIST_SITE_URL=https://wishlist.example.com
BRIDGE_SHARED_SECRET=xxx
